RewriteEngine On

# www -> nimcode.de
RewriteCond %{HTTP_HOST} ^www\.nimcode\.de$ [NC]
RewriteRule ^ https://nimcode.de%{REQUEST_URI} [L,R=301]

# http -> https
RewriteCond %{HTTP_HOST} ^nimcode\.de$ [NC]
RewriteCond %{HTTPS} off
RewriteRule ^ https://nimcode.de%{REQUEST_URI} [L,R=301]

# Kurzes Caching für HTML/CSS/JS, damit Änderungen schnell sichtbar sind
<IfModule mod_headers.c>
  <FilesMatch "\.(html|css|js)$">
    Header set Cache-Control "public, max-age=300, must-revalidate"
  </FilesMatch>
</IfModule>
